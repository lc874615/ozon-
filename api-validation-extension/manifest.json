{
  "manifest_version": 3,
  "name": "Ozon API 本地验证",
  "version": "0.1.1",
  "description": "独立API读取验证：全变体、时效>=7天、批量调度；不创建、不改价、不发布。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://www.ozon.ru/*",
    "https://ozon.ru/*",
    "https://seller.ozon.ru/*",
    "https://seller.ozonru.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}