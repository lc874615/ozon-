{
  "manifest_version": 3,
  "name": "Ozon API 本地验证",
  "version": "0.3.1",
  "description": "API验证：筛选后临时复制取包装，不清理、不发布、不改价库存。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://www.ozon.ru/*",
    "https://ozon.ru/*",
    "https://seller.ozon.ru/*",
    "https://seller.ozonru.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}