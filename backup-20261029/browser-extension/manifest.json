{
  "manifest_version": 3,
  "name": "Ozon 买家端采集助手",
  "version": "0.3.6",
  "description": "读取Ozon商品参数；仅在本地读取后台公司标识以查询，不导出Cookie。当前详情创建请求已停用。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "https://www.ozon.ru/*",
    "https://ozon.ru/*",
    "https://seller.ozon.ru/*",
    "https://seller.ozonru.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ozon.ru/product/*",
        "https://ozon.ru/product/*"
      ],
      "js": [
        "response-monitor.js",
        "attribute-monitor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://seller.ozon.ru/*",
        "https://seller.ozonru.cn/*"
      ],
      "js": [
        "seller-runtime.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
