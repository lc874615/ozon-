{
  "manifest_version": 3,
  "name": "Ozon 采集与参数工作台",
  "version": "0.5.16",
  "description": "按已确认规则进行买家筛选、卖家取参、退出与自动换批；不发布商品。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "alarms",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://www.ozon.ru/*",
    "https://ozon.ru/*",
    "https://seller.ozon.ru/*",
    "https://seller.ozonru.cn/*"
  ],
  "version_name": "0.5.16 confirmed collection rules"
}
