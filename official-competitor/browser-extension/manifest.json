{
  "manifest_version": 3,
  "name": "Ozon 采集与参数工作台",
  "version": "0.4.6",
  "description": "买家端串行队列采集，验证时暂停，完成后停止；另含卖家当前页参数导出。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://www.ozon.ru/*",
    "https://ozon.ru/*"
  ]
}
