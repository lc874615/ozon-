{
  "manifest_version": 3,
  "name": "Ozon 采集与参数工作台",
  "version": "0.4.2",
  "description": "用户点击采集买家页、整理待采集队列、导出卖家参数；不自动创建或发布商品。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
