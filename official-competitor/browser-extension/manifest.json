{
  "manifest_version": 3,
  "name": "Ozon 当前商品参数导出",
  "version": "0.4.1",
  "description": "用户点击后读取当前商品表单并导出JSON。无Cookie权限、持久网站权限或自动账号请求；不会填表或提交。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
